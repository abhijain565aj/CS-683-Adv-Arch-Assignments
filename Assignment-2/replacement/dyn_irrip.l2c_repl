
#include "cache.h"

#include <cstdlib>
#include <cerrno>
#include <cmath>

#define maxRRPV 3
#define RESET_INTERVAL 4096

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

uint64_t instr_accesses = 0;
uint64_t instr_misses = 0;
uint64_t total_accesses = 0;
uint64_t total_misses = 0;

double threshold = 0.25;
bool use_irrip = false;

void CACHE::l2c_initialize_replacement()
{
    threshold = 0.25;

    const char *value = std::getenv("CHAMPSIM_THRESHOLD");

    if (value != nullptr) {
        char *end = nullptr;
        errno = 0;

        double parsed = std::strtod(value, &end);

        if (end != value && *end == '\0' &&
            errno != ERANGE && std::isfinite(parsed) &&
            parsed >= 0.0 && parsed <= 1.0) {
            threshold = parsed;
        }
        else {
            cerr << "Invalid CHAMPSIM_THRESHOLD: "
                 << value << ", using 0.25" << endl;
        }
    }

    cout << "Initialize Dynamic I-RRIP for L2C" << endl;
    cout << "Dynamic I-RRIP threshold: " << threshold << endl;

    instr_accesses = 0;
    instr_misses = 0;
    total_accesses = 0;
    total_misses = 0;
    use_irrip = false;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

uint32_t CACHE::l2c_find_victim(
    uint32_t cpu, uint64_t instr_id, uint32_t set,
    const BLOCK *current_set, uint64_t ip,
    uint64_t full_addr, uint32_t type)
{
    bool irrip = false;

    if (set % 32 == 1)
        irrip = true;
    else if (set % 32 != 0)
        irrip = use_irrip;

    // Prefer an empty way before replacing a valid line.
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    while (1) {
        // In I-RRIP mode, prefer evicting a data line.
        if (irrip) {
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV &&
                    !current_set[i].instruction)
                    return i;
            }
        }

        // Regular RRIP victim selection.
        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV)
                return i;
        }

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    return 0;
}

void CACHE::l2c_update_replacement_state(
    uint32_t cpu, uint32_t set, uint32_t way,
    uint64_t full_addr, uint64_t ip, uint64_t victim_addr,
    uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    // Leader sets determine the mode for follower sets.
    // Do not count prefetches or writebacks as demand accesses.
    if ((set % 32 == 0 || set % 32 == 1) &&
        type != PREFETCH && type != WRITEBACK) {

        total_accesses++;

        if (isInstruction)
            instr_accesses++;

        if (!hit) {
            total_misses++;

            if (isInstruction)
                instr_misses++;
        }

        double ratio =
            (double)(instr_accesses + instr_misses) /
            (total_accesses + total_misses);

        use_irrip = (ratio >= threshold);

        if (total_accesses >= RESET_INTERVAL) {
            instr_accesses = 0;
            instr_misses = 0;
            total_accesses = 0;
            total_misses = 0;
        }
    }

    bool irrip = false;

    if (set % 32 == 1)
        irrip = true;
    else if (set % 32 != 0)
        irrip = use_irrip;

    if (irrip) {
        if (hit) {
            if (isInstruction)
                l2_rrpv[set][way] = 0;
            else
                l2_rrpv[set][way] = 1;
        }
        else {
            if (isInstruction)
                l2_rrpv[set][way] = 1;
            else
                l2_rrpv[set][way] = maxRRPV - 1;
        }
    }
    else {
        if (hit)
            l2_rrpv[set][way] = 0;
        else
            l2_rrpv[set][way] = maxRRPV - 1;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "Dynamic I-RRIP threshold: " << threshold << endl;
    cout << "Dynamic I-RRIP final mode: "
         << (use_irrip ? "I-RRIP" : "RRIP") << endl;
}
